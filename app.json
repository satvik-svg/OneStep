{
  "expo": {
    "name": "OneStep",
    "slug": "onestep-offline-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "onestep",
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "todo-reminders",
          "color": "#2f6b4f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OneStep to attach images to your tasks."
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f8f4ec"
      },
      "package": "com.onestep.offlinetodo",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ]
    }
  }
}
