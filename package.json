{
  "name": "onestep-offline-todo",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --lan --clear",
    "start:lan": "expo start --lan --clear",
    "start:tunnel": "expo start --tunnel --clear",
    "start:localhost": "expo start --localhost --clear",
    "android": "expo run:android --device",
    "android:emulator": "expo run:android",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:install-release": "cd android && ./gradlew installRelease",
    "export:android": "expo export --platform android --output-dir /private/tmp/onestep-export",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~56.0.0",
    "expo-constants": "~56.0.16",
    "expo-file-system": "~56.0.7",
    "expo-image-picker": "~56.0.15",
    "expo-notifications": "~56.0.15",
    "expo-sqlite": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~56.0.14",
    "typescript": "~6.0.3"
  }
}
